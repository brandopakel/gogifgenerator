# GoGIF Scene worker. Copy to .env.worker on the Windows/NVIDIA host; never
# commit the populated file. The worker opens outbound HTTPS connections only.
GOGIF_SCENE_API_URL=https://bs-macbook-air.tail916334.ts.net
GOGIF_SCENE_WORKER_TOKEN=
GOGIF_SCENE_WORKER_ID=

# Semantic source acquisition happens on Comfy Cloud. The key stays on the
# worker and is never sent to the GoGIF API or browser.
COMFY_CLOUD_API_KEY=
GOGIF_COMFYUI_IMAGE_URL=https://cloud.comfy.org/api
GOGIF_COMFYUI_IMAGE_RECIPE=flux-ultra

# Installed render tools and the checked-out GoGIF Unreal project.
GOGIF_BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
GOGIF_UNREAL_EXECUTABLE=C:\Program Files\Epic Games\UE_5.8\Engine\Binaries\Win64\UnrealEditor-Cmd.exe
GOGIF_UNREAL_PROJECT=C:\gogifgenerator\engines\unreal\GoGIF.uproject
GOGIF_UNREAL_SCRIPT=C:\gogifgenerator\engines\unreal\Content\Python\gogif_render.py
GOGIF_FFMPEG_EXECUTABLE=C:\ffmpeg\bin\ffmpeg.exe

# A fast local SSD is strongly preferred. Each workspace is removed after its
# artifacts upload or the attempt finishes.
GOGIF_SCENE_WORKSPACE_ROOT=C:\gogif-workspaces
GOGIF_SCENE_POLL_INTERVAL=5s
GOGIF_SCENE_HEARTBEAT_INTERVAL=30s
GOGIF_SCENE_REFERENCE_TIMEOUT=10m
GOGIF_SCENE_BLENDER_TIMEOUT=10m
GOGIF_SCENE_UNREAL_TIMEOUT=45m
GOGIF_SCENE_FFMPEG_TIMEOUT=20m
