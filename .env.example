# Server
GOGIF_ADDR=:8080
GOGIF_PUBLIC_URL=http://localhost:8080

# Optional paid AI planning. Both values are required before the key is used.
GOGIF_ENABLE_PAID_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Prompt interpretation engine: "local", "openai", or "huggingface". Empty
# picks OpenAI when paid planning is on, then Hugging Face when it is ready,
# then the offline reader. Every choice falls back to the offline reader.
GOGIF_PLANNER=

# Optional open-weights planning through an OpenAI-compatible chat endpoint.
# The Hugging Face router bills at the provider's own rate and therefore needs
# GOGIF_ENABLE_PAID_AI=true. Point the base URL at a loopback server instead
# — llama.cpp, Ollama, vLLM — to plan with a local quantized model for free
# and with no token.
HUGGINGFACE_API_KEY=
GOGIF_HUGGINGFACE_MODEL=openai/gpt-oss-120b:cheapest
GOGIF_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Semantic search ranking: "lexical" (offline, default), "none", or
# "huggingface". Ranking always degrades to the offline embedder, so search
# never depends on it. A loopback GOGIF_EMBEDDING_URL runs a local quantized
# embedding server instead of the hosted one.
GOGIF_EMBEDDING_PROVIDER=lexical
GOGIF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GOGIF_EMBEDDING_URL=https://router.huggingface.co
# How much the meaning score counts against the provider's own ordering, 0..1.
GOGIF_EMBEDDING_WEIGHT=0.6

# Optional paid semantic source imagery. This opt-in is independent of paid
# planning; the API key remains server-side and is never sent to the browser.
GOGIF_ENABLE_PAID_IMAGE_GENERATION=false
GOGIF_OPENAI_IMAGE_MODEL=gpt-image-2
GOGIF_OPENAI_IMAGE_QUALITY=high

# Optional: GIPHY requires search calls from the client, so this key is exposed
# to the web app at runtime. Use a platform-specific GIPHY key.
GIPHY_API_KEY=

# Optional still-image engine: "blender", "comfyui", "comfyui-cloud", or
# "openai".
GOGIF_IMAGE_GENERATOR=
GOGIF_BLENDER_EXECUTABLE=blender
# Optional short-video decoder. The feature is disabled when this executable
# cannot be found; photo and GIF editing continue to work.
GOGIF_FFMPEG_EXECUTABLE=ffmpeg

# Local semantic image generation uses ComfyUI's loopback API.
GOGIF_COMFYUI_URL=http://127.0.0.1:8188
GOGIF_COMFYUI_CHECKPOINT=
# Required only for reference-image transformation. This must be the local
# ComfyUI input directory so GoGIF can delete every temporary upload.
GOGIF_COMFYUI_INPUT_DIR=

# Workflow graph: "sd-checkpoint" (default) or "flux-gguf". The quantized
# recipe loads a GGUF transformer through the ComfyUI-GGUF custom nodes, which
# is how a FLUX-class model fits an 8-16 GB GPU. It has no reference-image
# path and refuses requests that carry one.
GOGIF_COMFYUI_RECIPE=sd-checkpoint
GOGIF_COMFYUI_GGUF_UNET=
GOGIF_COMFYUI_GGUF_CLIP_L=
GOGIF_COMFYUI_GGUF_CLIP_T5=
GOGIF_COMFYUI_GGUF_VAE=
GOGIF_COMFYUI_GGUF_GUIDANCE=3.5
# Sampling steps. Leave at 0 for the adapter default; schnell-class quantized
# models want about 4.
GOGIF_COMFYUI_STEPS=0

# Allow ComfyUI on a private or Tailscale address instead of loopback, so a
# workstation GPU can serve a laptop. Prompts then leave this machine, so it
# is off by default and the host must be RFC1918, 100.64.0.0/10, or *.ts.net.
GOGIF_COMFYUI_PRIVATE_ENDPOINT=false
GOGIF_COMFYUI_AUTH_TOKEN=

# Optional hosted semantic imagery through an allowlisted FLUX 1.1 Pro Ultra
# Partner Node workflow. Cloud execution needs a Creator/Pro subscription;
# Partner Node inference also consumes Comfy credits.
COMFY_CLOUD_API_KEY=
GOGIF_COMFYUI_IMAGE_URL=https://cloud.comfy.org/api
GOGIF_COMFYUI_IMAGE_RECIPE=flux-ultra
# Hosted vision QA rejects unrelated, letterboxed, watermarked, text-covered,
# or collage-like source images and retries at most this many total attempts.
GOGIF_SEMANTIC_MAX_ATTEMPTS=2
# Explicit paid opt-in for Luma Ray 3.2 image-to-video motion. FFmpeg samples
# the five-second hosted loop into the selected GIF frame count and speed.
GOGIF_ENABLE_PAID_MOTION_GENERATION=false

# Optional paid 3D creation through an allowlisted ComfyUI Partner Node
# workflow. A Comfy account key and explicit spend opt-in are both required.
# Use the local URL to let Desktop orchestrate Partner Nodes, or use
# https://cloud.comfy.org/api with a Comfy Cloud subscription.
GOGIF_ENABLE_PAID_MODEL_GENERATION=false
GOGIF_MODEL_GENERATOR=
GOGIF_COMFYUI_MODEL_URL=http://127.0.0.1:8188
GOGIF_COMFYUI_MODEL_RECIPE=tripo-3.1

# Optional Studio Local renderer. This keeps a third create mode available but
# does not run for normal Realistic AI requests. A Studio request launches all
# three editors and is intentionally very heavy on memory and CPU/GPU.
GOGIF_ENABLE_QUALITY_PIPELINE=false

# Asynchronous Scene projects are hidden and disabled until a remote renderer
# and private artifact storage are configured. Keep Unreal as the only hosted
# target until Unity grants the required SaaS/cloud processing rights.
GOGIF_ENABLE_SCENE_JOBS=false
GOGIF_SCENE_WORKER_TOKEN=
GOGIF_SCENE_TARGETS=unreal

GOGIF_UNITY_EXECUTABLE=Unity
GOGIF_UNITY_PROJECT=
GOGIF_UNITY_METHOD=GoGIF.Editor.BatchRenderer.Render
GOGIF_UNREAL_EXECUTABLE=UnrealEditor-Cmd
GOGIF_UNREAL_PROJECT=
GOGIF_UNREAL_SCRIPT=

# Optional local persistence. Existing provider media is never stored here.
GOGIF_MEMKV_ADDR=
GOGIF_BLOB_DIR=.data/blobs

# Optional accounts. "disabled" preserves the current account-free behavior;
# "local" is one unmetered owner; "oidc" enables real multi-user accounts.
# OIDC requires durable MemKV and a callback registered at
# GOGIF_PUBLIC_URL/api/v1/auth/callback.
GOGIF_AUTH_MODE=disabled
GOGIF_SESSION_SECRET=
GOGIF_LOCAL_OWNER_EMAIL=
GOGIF_OIDC_ISSUER=
GOGIF_OIDC_CLIENT_ID=
GOGIF_OIDC_CLIENT_SECRET=
GOGIF_OIDC_REDIRECT_URL=

# Optional Stripe subscriptions. Billing requires OIDC accounts, HTTPS, a
# verified webhook endpoint, and server-side recurring Price IDs. Use test mode
# until checkout, portal, renewal, cancellation, and failed-payment paths pass.
GOGIF_ENABLE_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
GOGIF_CREATOR_PRICE_CENTS=1500
GOGIF_PRO_PRICE_CENTS=3900
