# Server
GOGIF_ADDR=:8080

# Optional: enables AI-directed art planning. The key is only used server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: GIPHY requires search calls from the client, so this key is exposed
# to the web app at runtime. Use a platform-specific GIPHY key.
GIPHY_API_KEY=
