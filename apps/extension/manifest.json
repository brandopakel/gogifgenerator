{
  "manifest_version": 3,
  "name": "GoGIF Local",
  "description": "Create a GIF from the browser toolbar with your private local GoGIF engine.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Create with GoGIF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "host_permissions": ["http://localhost:8080/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "gogif@brandopakel.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
